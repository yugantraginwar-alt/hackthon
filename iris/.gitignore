# ==============================================================================
# IRIS — Intelligent Risk & Impersonation Shield (.gitignore)
# Production-quality Git ignore rules for Python FastAPI + React/Vite + ML
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment & Secrets (NEVER COMMIT CREDENTIALS)
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
*.pem
*.key
*.cert
*.crt
secrets/
credentials/
*.p12
*.pfx

# ------------------------------------------------------------------------------
# Node / React / Next.js / Vite
# ------------------------------------------------------------------------------
node_modules/
.next/
out/
dist/
build/
.npm/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.vite/

# ------------------------------------------------------------------------------
# Python / FastAPI
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
pip-log.txt
pip-delete-this-directory.txt
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------------------------------------------
# Machine Learning / Binary Artifacts / Generated Weights
# ------------------------------------------------------------------------------
*.joblib
*.pkl
*.pickle
*.h5
*.hdf5
*.onnx
*.pt
*.pth
*.bin
checkpoints/
runs/
saved_model/*.joblib
saved_model/*.pkl

# Whitelist Pydantic python files so they are not confused with ML models
!**/backend/models/*.py
!**/backend/models/__init__.py

# Re-enforce ignoring any pycache inside whitelisted folders
**/__pycache__/**
**/*.py[cod]

# ------------------------------------------------------------------------------
# Uploaded & Temporary Runtime Files
# ------------------------------------------------------------------------------
uploads/
tmp/
temp/
cache/
logs/
*.log
.system_generated/

# ------------------------------------------------------------------------------
# Database & Local Storage (SQLite / Local Dev Dumps)
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
*.sql.gz

# ------------------------------------------------------------------------------
# Docker
# ------------------------------------------------------------------------------
docker-compose.override.yml
*.env.docker

# ------------------------------------------------------------------------------
# IDE & Code Editors
# ------------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.project
.settings/

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# Build & Deployment
# ------------------------------------------------------------------------------
.vercel/
.terraform/
coverage/
