# ==============================================================================
# IRIS — Intelligent Risk & Impersonation Shield (Environment Configuration)
# Copy this file to .env and configure your local settings.
# Do NOT commit real secrets or production keys to version control.
# ==============================================================================

# Backend Environment
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=127.0.0.1

# Database Configuration
# Default is local SQLite. For PostgreSQL (e.g. Supabase, Railway, Docker):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/iris
DATABASE_URL=sqlite:///./iris.db

# Threat Intelligence API Keys (Optional - Local heuristics will be used if omitted)
# Google Safe Browsing API v4 Key
GSB_API_KEY=your_google_safe_browsing_api_key_here

# VirusTotal API Key
VT_API_KEY=your_virustotal_api_key_here

# Frontend Configuration (for iris/frontend/.env)
VITE_API_URL=http://localhost:8000/api
